# ===== MissingCash Backend Config =====
PORT=3000

# Amazon Selling Partner API (SP-API) — MCF credentials
# Apply at: https://developer.amazonservices.com.au
AMZ_CLIENT_ID=your_sp_api_client_id
AMZ_CLIENT_SECRET=your_sp_api_client_secret
AMZ_REFRESH_TOKEN=your_refresh_token
AMZ_MARKETPLACE_ID=A39IBJ37TRP1C6
AMZ_SELLER_ID=your_seller_id
AMZ_REGION=eu-west-1
# Set USE_MOCK=true until Amazon approves your SP-API app
USE_MOCK=true
